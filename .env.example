# Copy this to .env and paste your keys in.  cp .env.example .env
# .env is gitignored — never commit it, and never paste keys anywhere public.
#
# The pipeline (which runs on your machine) needs APIFY_TOKEN and OPENAI_API_KEY.
# The website (which runs on Vercel) needs only OPENAI_API_KEY, and you set that
# in the Vercel dashboard rather than here:
#   Vercel → Project → Settings → Environment Variables

# --- pipeline + website -----------------------------------------------------
OPENAI_API_KEY=sk-proj-XXXXXXXX

# --- pipeline only ----------------------------------------------------------
APIFY_TOKEN=apify_api_XXXXXXXX

# --- website only -----------------------------------------------------------
# Which model answers "Ask the archive". Cheap and quick by default.
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- which model does the video reasoning -----------------------------------
# openai   = frames -> OpenAI vision (the cookbook approach). Works today.
# seedance = frames -> BytePlus Ark. Returned AccountOverdueError last time the
#            balance was checked; top it up before switching.
VISION_PROVIDER=openai
OPENAI_VISION_MODELS=gpt-4.1-mini,gpt-4o,gpt-4o-mini

SEEDANCE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=seed-1-8-251228

# Defaults you can change without touching the code
DEFAULT_USERNAME=anmolraina13
FRAME_HEIGHT=720
JPEG_QUALITY=4
MAX_RETRIES=3
REQUEST_TIMEOUT=300

# --- frame sampling ---------------------------------------------------------
# Frames scale with reel length: one still every FRAME_EVERY_SEC seconds,
# clamped between FRAMES_MIN and FRAMES_MAX. Override per run with --frames N.
FRAME_EVERY_SEC=4
FRAMES_MIN=8
FRAMES_MAX=20

# --- transcript trust thresholds --------------------------------------------
# Whisper reports its own uncertainty per segment. Anything past these is the
# model guessing over music or silence, and is deleted before the reasoning step
# so a made-up sentence can never become "evidence". The exporter applies the
# same thresholds, so the transcript on the page is what the model actually saw.
NO_SPEECH_MAX=0.6
AVG_LOGPROB_MIN=-0.8
COMPRESSION_MAX=2.4
